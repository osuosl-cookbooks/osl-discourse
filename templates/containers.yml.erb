# This file was generated by Chef (osl-discourse cookbook). DO NOT edit by hand.

templates:
  - "templates/redis.template.yml"
  - "templates/web.template.yml"
  - "templates/web.ratelimited.template.yml"
<% unless @trusted_proxies.empty? -%>
  - "templates/web.realip.template.yml"
<% end -%>
<% @extra_templates.each do |t| -%>
  - "<%= t %>"
<% end -%>

## host networking; ports owned by host
expose:

params:
  db_default_text_search_config: "<%= @db_default_text_search_config %>"
  version: <%= @discourse_version %>
<% @extra_params.each do |k, v| -%>
  <%= k %>: <%= v.is_a?(String) ? v.inspect : v %>
<% end -%>

env:
  LANG: en_US.UTF-8
  UNICORN_WORKERS: <%= @unicorn_workers %>
  DISCOURSE_HOSTNAME: <%= @hostname %>
  DOCKER_USE_HOSTNAME: true
  DISCOURSE_DEVELOPER_EMAILS: '<%= @developer_emails %>'
<% if @locale -%>
  DISCOURSE_DEFAULT_LOCALE: <%= @locale %>
<% end -%>
<% if @notification_email -%>
  DISCOURSE_NOTIFICATION_EMAIL: <%= @notification_email %>
<% end -%>
<% if @cdn_url -%>
  DISCOURSE_CDN_URL: <%= @cdn_url %>
<% end -%>
<% if @force_https -%>
  DISCOURSE_FORCE_HTTPS: true
<% end -%>
  DISCOURSE_SMTP_ADDRESS: <%= @smtp_address %>
  DISCOURSE_SMTP_PORT: <%= @smtp_port %>
  DISCOURSE_SMTP_AUTHENTICATION: <%= @smtp_authentication %>
<% if @smtp_user_name -%>
  DISCOURSE_SMTP_USER_NAME: <%= @smtp_user_name %>
  DISCOURSE_SMTP_PASSWORD: "<%= @smtp_password %>"
<% end -%>
<% if @smtp_force_tls -%>
  DISCOURSE_SMTP_FORCE_TLS: true
<% end -%>
<% if @smtp_domain -%>
  DISCOURSE_SMTP_DOMAIN: <%= @smtp_domain %>
<% end -%>
  DISCOURSE_DB_HOST: <%= @db_host %>
  DISCOURSE_DB_PORT: <%= @db_port %>
  DISCOURSE_DB_BACKUP_PORT: <%= @db_backup_port %>
  DISCOURSE_DB_USERNAME: <%= @db_user %>
  DISCOURSE_DB_PASSWORD: <%= @db_password %>
  DISCOURSE_DB_NAME: <%= @db_name %>
  DISCOURSE_MAXIMUM_BACKUPS: <%= @backup_max %>
<% @extra_env.each do |k, v| -%>
  <%= k %>: <%= v %>
<% end -%>

## The Docker container is stateless; all data is stored in /shared
volumes:
  - volume:
      host: /var/discourse/shared/<%= @shared_path %>
      guest: /shared
  - volume:
      host: /var/discourse/shared/<%= @shared_path %>/log/var-log
      guest: /var/log

hooks:
  after_code:
    - exec:
        cd: $home/plugins
        cmd:
          - git clone https://github.com/discourse/docker_manager.git
<% @plugins.each do |url| -%>
          - git clone <%= url %>
<% end -%>
    - exec:
        cmd:
          - apt-get update && apt-get install -y postgresql-<%= @pg_client_version %>
          - echo "* * <%= @pg_client_version %> main *" >> /etc/postgresql-common/user_clusters
          - apt-get clean
<% if @listen_port.to_s != '80' -%>
  # Discourse hard-codes the nginx listen port. discourse_docker (main) seds the
  # listen lines out of discourse.conf and writes them to this outlet file (both
  # IPv4 and IPv6 on dual-stack hosts), so rewrite them here. Rendered only when
  # the port differs from 80 to keep default instances byte-identical.
  after_web_config:
    - replace:
        filename: "/etc/nginx/conf.d/outlets/server/10-http.conf"
        from: "listen 80;"
        to: "listen <%= @listen_port %>;"
    - replace:
        filename: "/etc/nginx/conf.d/outlets/server/10-http.conf"
        from: "listen [::]:80;"
        to: "listen [::]:<%= @listen_port %>;"
<% end -%>

run:
  - exec: echo "Beginning of custom commands"
  - exec: echo "End of custom commands"
